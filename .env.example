# Google OAuth (Cloud Console → Credentials → OAuth client ID → Web application)
# Необов'язково — якщо не задано, вхід за паролем працює без Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
# Обмежити вхід доменом Workspace (порожньо = будь-який Google-акаунт)
NEXT_PUBLIC_ALLOWED_DOMAIN=checkbox.ua

# Redis. Ці змінні Vercel додає сам, коли підключити Upstash у Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Вхід за іменем і паролем. Можна вказати декілька дійсних паролів одразу —
# через кому або з нового рядка. Будь-хто, хто ввів своє ім'я і один із цих
# паролів, зможе увійти.
APP_PASSWORDS=пароль-один, пароль-два, пароль-три

# Стара змінна (один пароль). Якщо задано APP_PASSWORDS — ця ігнорується.
# APP_PASSWORD=
